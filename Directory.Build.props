<Project>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>

    <!-- Override with -p:GameDir="..." on the command line, or set env var HHGameDir -->
    <GameDir Condition="'$(GameDir)' == '' AND '$(HHGameDir)' != ''">$(HHGameDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Human Host</GameDir>
    <ManagedDir>$(GameDir)\Human Host_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins\HHMods</PluginsDir>

    <!-- Set DeployOnBuild=false to skip auto-copy after build -->
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">true</DeployOnBuild>
  </PropertyGroup>

  <!-- BepInEx + Harmony pulled directly from the game's BepInEx install.
       Avoids the pre-release-only BepInEx NuGet feed. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Harmony"><HintPath>$(BepInExCoreDir)\BepInEx.Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCoreDir)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Game assemblies. Private=false so we don't copy them next to our plugins. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Creature"><HintPath>$(ManagedDir)\Creature.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UI"><HintPath>$(ManagedDir)\UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Build_System"><HintPath>$(ManagedDir)\Build_System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Terrain"><HintPath>$(ManagedDir)\Terrain.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Player"><HintPath>$(ManagedDir)\Player.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Player_HotKeys"><HintPath>$(ManagedDir)\Player_HotKeys.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mgr_Hub"><HintPath>$(ManagedDir)\Mgr_Hub.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Item_Info"><HintPath>$(ManagedDir)\Item_Info.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Notifications"><HintPath>$(ManagedDir)\Notifications.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CompassPro"><HintPath>$(ManagedDir)\CompassPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Weather"><HintPath>$(ManagedDir)\Weather.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Kybernetik.Animancer"><HintPath>$(ManagedDir)\Kybernetik.Animancer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Language"><HintPath>$(ManagedDir)\Language.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Car"><HintPath>$(ManagedDir)\Car.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Bicycle"><HintPath>$(ManagedDir)\Bicycle.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Hand_Tools"><HintPath>$(ManagedDir)\Hand_Tools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Trap"><HintPath>$(ManagedDir)\Trap.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Equipment"><HintPath>$(ManagedDir)\Equipment.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sound_FX"><HintPath>$(ManagedDir)\Sound_FX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SaveData"><HintPath>$(ManagedDir)\SaveData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Camera"><HintPath>$(ManagedDir)\Camera.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Static_Class"><HintPath>$(ManagedDir)\Static_Class.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Global_Funcs"><HintPath>$(ManagedDir)\Global_Funcs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Digger.Core"><HintPath>$(ManagedDir)\Digger.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Digger.Runtime"><HintPath>$(ManagedDir)\Digger.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(ManagedDir)\UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(ManagedDir)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedDir)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>

    <!-- Unity engine + modules we touch -->
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(ManagedDir)\UnityEngine.TerrainModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
